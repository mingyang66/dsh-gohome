{
  "name": "dsh-gohome",
  "version": "1.1.1",
  "type": "module",
  "description": "Workday countdown below the message composer for DeepSeek Harness.",
  "license": "MIT",
  "author": "Lumina",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "countdown",
    "workday",
    "offwork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingyang66/dsh-gohome.git"
  },
  "homepage": "https://github.com/mingyang66/dsh-gohome#readme",
  "bugs": {
    "url": "https://github.com/mingyang66/dsh-gohome/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.5": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}